# ============================================================================
#  Настройки бота записи. Скопируйте этот файл в .env и заполните значения.
#      cp .env.example .env
#  Файл .env содержит секреты — никогда не публикуйте его и не кладите в git.
# ============================================================================

# --- Meta / WhatsApp Cloud API ------------------------------------------------
# Версия API вынесена отдельно: когда Meta объявит текущую версию устаревшей,
# достаточно поменять здесь номер и перезапустить контейнер. Код трогать не нужно.
META_API_BASE_URL=https://graph.facebook.com
META_API_VERSION=v20.0

# ID номера телефона (Phone number ID) из панели Meta for Developers.
# ВАЖНО: это НЕ сам номер телефона, а числовой идентификатор рядом с ним.
WHATSAPP_PHONE_NUMBER_ID=

# Настоящий номер владелицы в международном формате БЕЗ "+" и пробелов,
# например 77011234567. Подключение идёт через Coexistence (см. README,
# раздел 3) — приложение на её телефоне и бот работают на одном номере.
# По этому значению бот отличает "написала сама владелица" от "написал
# клиент" и замолкает в диалоге, куда она ответила лично.
WHATSAPP_BUSINESS_NUMBER=

# Постоянный токен доступа (System User Token). Обычный временный токен на 24 часа
# НЕ подходит — бот перестанет работать на следующий день. См. README, раздел 3.
WHATSAPP_ACCESS_TOKEN=

# Произвольная строка, которую вы сами придумываете. Её же вводят в панели Meta
# при подключении вебхука. Служит паролем при проверке адреса вебхука.
WHATSAPP_VERIFY_TOKEN=

# App Secret из настроек приложения Meta. Нужен для проверки подписи входящих
# запросов — без него кто угодно сможет слать боту поддельные сообщения.
WHATSAPP_APP_SECRET=

# --- Google Sheets ------------------------------------------------------------
# Путь к JSON-ключу сервисного аккаунта внутри контейнера. Сам файл кладётся
# в папку ./secrets на сервере — она монтируется в контейнер только на чтение.
GOOGLE_SERVICE_ACCOUNT_FILE=/app/secrets/service-account.json

# ID таблицы — часть ссылки между /d/ и /edit:
# docs.google.com/spreadsheets/d/ЭТА_ЧАСТЬ_И_ЕСТЬ_ID/edit
GOOGLE_SPREADSHEET_ID=

# Названия листов внутри таблицы. Меняйте, только если переименовали листы.
SHEET_SERVICES=Услуги
SHEET_LEADS=Заявки
SHEET_FAQ=Вопросы

# --- Поведение бота -----------------------------------------------------------
# Через сколько минут бездействия забыть незаконченную заявку и начать заново.
SESSION_TIMEOUT_MINUTES=30

# На сколько часов бот замолкает в диалоге с клиентом после того, как в
# переписку вступила сама владелица (или клиент попросил менеджера).
HUMAN_TAKEOVER_HOURS=24

# Сколько раз повторять запрос к Google/Meta при временной ошибке связи.
MAX_RETRIES=3

# Название салона — подставляется в приветствие.
BUSINESS_NAME=Салон красоты

# Куда писать телефон администратора, если клиент попросит живого человека.
ADMIN_CONTACT=+7 700 000 00 00

# --- Служебное ----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=/app/logs
DATA_DIR=/app/data
PORT=8080
